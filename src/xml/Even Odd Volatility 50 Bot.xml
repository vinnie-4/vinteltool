<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="stake_even_odd">Stake</variable>
    <variable id="initial_stake_even_odd">Initial Stake</variable>
    <variable id="martingale_even_odd">Martingale</variable>
    <variable id="take_profit_even_odd">Take Profit</variable>
    <variable id="stop_loss_even_odd">Stop Loss</variable>
    <variable id="session_profit_even_odd">Session Profit</variable>
  </variables>
  <block type="trade_definition" id="evenodd_trade_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="evenodd_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_50</field>
        <field name="HIDE_TRADE_PARAMETERS">FALSE</field>
        <next>
          <block type="trade_definition_tradetype" id="evenodd_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="evenodd_contract" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="evenodd_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="evenodd_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="evenodd_error_restart" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="evenodd_set_stake">
        <field name="VAR" id="stake_even_odd">Stake</field>
        <value name="VALUE"><block type="math_number" id="evenodd_stake_value"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="evenodd_set_initial">
            <field name="VAR" id="initial_stake_even_odd">Initial Stake</field>
            <value name="VALUE"><block type="math_number" id="evenodd_initial_value"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="evenodd_set_martingale">
                <field name="VAR" id="martingale_even_odd">Martingale</field>
                <value name="VALUE"><block type="math_number" id="evenodd_martingale_value"><field name="NUM">2</field></block></value>
                <next>
                  <block type="variables_set" id="evenodd_set_tp">
                    <field name="VAR" id="take_profit_even_odd">Take Profit</field>
                    <value name="VALUE"><block type="math_number" id="evenodd_tp_value"><field name="NUM">10</field></block></value>
                    <next>
                      <block type="variables_set" id="evenodd_set_sl">
                        <field name="VAR" id="stop_loss_even_odd">Stop Loss</field>
                        <value name="VALUE"><block type="math_number" id="evenodd_sl_value"><field name="NUM">20</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="evenodd_trade_options">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><block type="math_number" id="evenodd_duration"><field name="NUM">1</field></block></value>
        <value name="AMOUNT"><block type="variables_get" id="evenodd_amount"><field name="VAR" id="stake_even_odd">Stake</field></block></value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="evenodd_before" deletable="false" x="620" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="evenodd_condition">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="evenodd_is_even">
            <field name="OP">EQ</field>
            <value name="A"><block type="math_modulo" id="evenodd_mod"><value name="DIVIDEND"><block type="last_digit" id="evenodd_last_digit"></block></value><value name="DIVISOR"><block type="math_number" id="evenodd_two"><field name="NUM">2</field></block></value></block></value>
            <value name="B"><block type="math_number" id="evenodd_zero"><field name="NUM">0</field></block></value>
          </block>
        </value>
        <statement name="DO0"><block type="purchase" id="evenodd_purchase_even"><field name="PURCHASE_LIST">DIGITEVEN</field></block></statement>
        <statement name="ELSE"><block type="purchase" id="evenodd_purchase_odd"><field name="PURCHASE_LIST">DIGITODD</field></block></statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="evenodd_after" x="620" y="350">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="evenodd_after_win">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0"><block type="contract_check_result" id="evenodd_win"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0"><block type="variables_set" id="evenodd_reset_stake"><field name="VAR" id="stake_even_odd">Stake</field><value name="VALUE"><block type="variables_get" id="evenodd_reset_initial"><field name="VAR" id="initial_stake_even_odd">Initial Stake</field></block></value></block></statement>
        <statement name="ELSE"><block type="variables_set" id="evenodd_double_stake"><field name="VAR" id="stake_even_odd">Stake</field><value name="VALUE"><block type="math_arithmetic" id="evenodd_multiply"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="evenodd_stake_current"><field name="VAR" id="stake_even_odd">Stake</field></block></value><value name="B"><block type="variables_get" id="evenodd_martingale_current"><field name="VAR" id="martingale_even_odd">Martingale</field></block></value></block></value></block></statement>
        <next>
          <block type="controls_if" id="evenodd_stop_check">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0"><block type="logic_compare" id="evenodd_tp_check"><field name="OP">GTE</field><value name="A"><block type="total_profit" id="evenodd_profit_tp"></block></value><value name="B"><block type="variables_get" id="evenodd_tp_var"><field name="VAR" id="take_profit_even_odd">Take Profit</field></block></value></block></value>
            <statement name="DO0"><block type="text_print" id="evenodd_tp_message"><value name="TEXT"><shadow type="text" id="evenodd_tp_text"><field name="TEXT">Take profit reached.</field></shadow></value></block></statement>
            <statement name="ELSE"><block type="controls_if" id="evenodd_sl_check"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation><value name="IF0"><block type="logic_compare" id="evenodd_sl_compare"><field name="OP">LTE</field><value name="A"><block type="total_profit" id="evenodd_profit_sl"></block></value><value name="B"><block type="math_single" id="evenodd_neg_sl"><field name="OP">NEG</field><value name="NUM"><block type="variables_get" id="evenodd_sl_var"><field name="VAR" id="stop_loss_even_odd">Stop Loss</field></block></value></block></value></block></value><statement name="DO0"><block type="text_print" id="evenodd_sl_message"><value name="TEXT"><shadow type="text" id="evenodd_sl_text"><field name="TEXT">Stop loss reached.</field></shadow></value></block></statement><statement name="ELSE"><block type="trade_again" id="evenodd_trade_again"></block></statement></block></statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>