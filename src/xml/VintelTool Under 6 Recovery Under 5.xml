<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
<variables>
  <variable type="" id="under6_stake">Stake</variable>
  <variable type="" id="under6_martingale">Martingale</variable>
  <variable type="" id="under6_prediction">Prediction</variable>
</variables>
<block type="trade_definition" id="under6_trade_definition" x="0" y="0">
  <statement name="TRADE_OPTIONS">
    <block type="trade_definition_market" id="under6_market" deletable="false" movable="false">
      <field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">R_25</field>
      <next><block type="trade_definition_tradetype" id="under6_tradetype" deletable="false" movable="false">
        <field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
        <next><block type="trade_definition_contracttype" id="under6_contract" deletable="false" movable="false">
          <field name="TYPE_LIST">DIGITUNDER</field>
          <next><block type="trade_definition_candleinterval" id="under6_candle"><field name="CANDLEINTERVAL_LIST">60</field>
            <next><block type="trade_definition_restartbuysell" id="under6_restart"><field name="TIME_MACHINE_ENABLED">FALSE</field>
              <next><block type="trade_definition_restartonerror" id="under6_error"><field name="RESTARTONERROR">FALSE</field></block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block>
  </statement>
  <statement name="INITIALIZATION">
    <block type="variables_set" id="under6_init_stake"><field name="VAR" id="under6_stake">Stake</field><value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
      <next><block type="variables_set" id="under6_init_martingale"><field name="VAR" id="under6_martingale">Martingale</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
        <next><block type="variables_set" id="under6_init_prediction"><field name="VAR" id="under6_prediction">Prediction</field><value name="VALUE"><block type="math_number"><field name="NUM">6</field></block></value></next>
      </block></next>
    </block>
  </statement>
  <statement name="SUBMARKET">
    <block type="trade_definition_tradeoptions" id="under6_options"><mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
      <field name="DURATIONTYPE_LIST">t</field><value name="DURATION"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      <value name="AMOUNT"><shadow type="math_number"><field name="NUM">0.35</field></shadow><block type="variables_get"><field name="VAR" id="under6_stake">Stake</field></block></value>
      <value name="PREDICTION"><shadow type="math_number"><field name="NUM">6</field></shadow><block type="variables_get"><field name="VAR" id="under6_prediction">Prediction</field></block></value>
    </block>
  </statement>
</block>
<block type="before_purchase" id="under6_before_purchase" x="0" y="620">
  <statement name="BEFOREPURCHASE_STACK"><block type="purchase" id="under6_purchase_under"><field name="PURCHASE_LIST">DIGITUNDER</field></block></statement>
</block>
<block type="after_purchase" id="under6_after_purchase" x="520" y="620">
  <statement name="AFTERPURCHASE_STACK"><block type="controls_if" id="under6_result"><mutation else="1"></mutation>
    <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
    <statement name="DO0"><block type="variables_set" id="under6_win_stake"><field name="VAR" id="under6_stake">Stake</field><value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
      <next><block type="variables_set" id="under6_win_prediction"><field name="VAR" id="under6_prediction">Prediction</field><value name="VALUE"><block type="math_number"><field name="NUM">6</field></block></value></block></next>
    </block></statement>
    <statement name="ELSE"><block type="variables_set" id="under6_loss_stake"><field name="VAR" id="under6_stake">Stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="under6_stake">Stake</field></value><value name="B"><block type="variables_get"><field name="VAR" id="under6_martingale">Martingale</field></value></block></value>
      <next><block type="variables_set" id="under6_loss_prediction"><field name="VAR" id="under6_prediction">Prediction</field><value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value></block></next>
    </block></statement>
    <next><block type="trade_again" id="under6_trade_again"></block></next>
  </block></statement>
</block>
</xml>
